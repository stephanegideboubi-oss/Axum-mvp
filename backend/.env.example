PORT=4000
DATABASE_URL=postgres://trustfund:trustfund_dev_pw@localhost:5432/trustfund
JWT_SECRET=change-me-dev-secret
JWT_EXPIRES_IN=7d
# Must be this backend's own public URL in production (e.g. https://api.example.com) -
# used to build absolute links to uploaded files so they render from the frontend's origin.
PUBLIC_BASE_URL=http://localhost:4000

# --- Payments ---------------------------------------------------------------
# Leave the placeholders as they are to keep the instant "simulated" payment only.
# To try real payments, put your own TEST-mode keys here (this file is a template:
# copy it to .env, which is git-ignored, and never commit real keys anywhere).
# Live keys (sk_live_..., FLWSECK-...) are ignored unless ALLOW_LIVE_PAYMENTS=true.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-placeholder
# The "secret hash" you choose in Flutterwave's webhook settings.
FLUTTERWAVE_WEBHOOK_HASH=placeholder

# Where providers send customers back to after paying (the frontend's public URL).
FRONTEND_URL=http://localhost:5173
# Set to "false" once real providers are live to remove the no-money demo method.
ALLOW_SIMULATED_PAYMENTS=true
ALLOW_LIVE_PAYMENTS=false
